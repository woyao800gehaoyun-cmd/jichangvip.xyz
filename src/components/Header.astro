---
const path = Astro.url.pathname;
const links = [
  { href: '/reviews/', label: '月度红黑榜' },
  { href: '/guides/', label: '客户端实操' },
  { href: '/routes/', label: '线路探秘' },
  { href: '/about/', label: '测试标准' }
];
---
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="硬核极客测速站首页">
      <span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span>
      <span><b>硬核极客测速站</b><small>独立网络评测媒体</small></span>
    </a>
    <nav class="main-nav" data-nav aria-label="主导航">
      <a class:list={{ active: path === '/' }} href="/">首页</a>
      {links.map(link => <a class:list={{ active: path.startsWith(link.href) }} href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="latest-button" href="/#latest">阅读最新测评</a>
      <button class="menu-button" data-menu-button aria-expanded="false" aria-label="打开菜单"><span></span><span></span></button>
    </div>
  </div>
</header>
