---
import type { Post } from '../data/posts';
interface Props { post: Post; index?: number; featured?: boolean; }
const { post, index = 0, featured = false } = Astro.props;
---
<article class:list={['post-card', { featured }]}>
  <a href={`/posts/${post.slug}/`} class="post-card-link" aria-label={post.title}></a>
  <div class={`post-visual visual-${index % 4}`} aria-hidden="true">
    <span class="visual-orbit"></span><span class="visual-dot"></span>
    <strong>{post.score ?? String(index + 1).padStart(2, '0')}</strong><small>{post.verdict ?? post.category}</small>
  </div>
  <div class="post-main">
    <div class="eyebrow"><span>{post.category}</span><code>{post.tag}</code></div>
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <div class="post-meta"><time datetime={post.date}>{post.dateLabel}</time><span>{post.readTime} 阅读</span><span>硬核实验室</span></div>
  </div>
</article>
