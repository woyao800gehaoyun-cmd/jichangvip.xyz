---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/posts';
const list = posts.filter(p => ['客户端实操', '客户端教程', '故障排查'].includes(p.category));
---
<Layout title="机场客户端教程｜Clash、V2RayN、小火箭与 sing-box" description="提供 Clash、V2RayN、Shadowrocket、Quantumult X、Stash、v2rayNG 与 sing-box 的订阅导入和故障排查。">
  <section class="page-hero"><div class="shell page-hero-grid"><div><span class="section-kicker">CLIENT GUIDES</span><h1>客户端教程，从订阅导入开始。</h1><p>覆盖 Clash 机场、V2RayN 机场、Shadowrocket 机场、Quantumult X、Stash、v2rayNG 和 sing-box 的配置与排错。</p></div><div class="page-stat"><div><strong>8+</strong><span>客户端生态</span></div><div><strong>4</strong><span>系统平台</span></div></div></div></section>
  <section class="section"><div class="shell"><span class="section-kicker">PRACTICAL GUIDES</span><div class="section-heading"><h2>把订阅、规则和故障讲明白</h2><p>示例先解释目的，再给排查顺序；不建议复制无法维护的未知配置。</p></div><div class="post-list">{list.map((post, index) => <PostCard post={post} index={index} />)}</div></div></section>
</Layout>
