---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';
const lead = posts[0];
const secondary = posts.slice(1, 4);
const latest = posts.slice(0, 6);
---
<Layout title="硬核极客测速站｜真实机场测速、晚高峰跑分与线路评测" description="硬核极客测速站提供真实机场测速截图、晚高峰跑分、Netflix 等流媒体解锁检测，以及 IPLC、IEPL、BGP 线路深度分析。">
  <div class="breaking"><div class="shell"><b>正在关注</b><div><span>晚高峰测速应该看 P95 延迟，而不是一次峰值</span><span>IPLC / IEPL / BGP 到底有什么区别？</span><span>Sing-box 规则分流实战</span></div></div></div>

  <section class="lead-section shell">
    <article class="lead-story">
      <a class="cover-link" href={`/posts/${lead.slug}/`} aria-label={lead.title}></a>
      <div class="lead-copy">
        <div class="category-label">本月头条 · 月度红黑榜</div>
        <h1>{lead.title}</h1>
        <p>{lead.excerpt}</p>
        <div class="story-meta"><time datetime={lead.date}>{lead.dateLabel}</time><span>{lead.readTime} 阅读</span><span>已完成 4 轮复测</span></div>
      </div>
      <div class="cover-art" aria-hidden="true"><span>MONTHLY<br/>REPORT</span><strong>10</strong><div><b>8.7</b><small>综合稳定度</small></div></div>
    </article>

    <aside class="lead-side" aria-label="热门内容">
      <div class="side-title"><span>编辑推荐</span><b>TOP STORIES</b></div>
      {secondary.map((post, index) => <article class="side-story"><a href={`/posts/${post.slug}/`} aria-label={post.title}></a><span>0{index + 1}</span><div><small>{post.category}</small><h2>{post.title}</h2><time datetime={post.date}>{post.dateLabel}</time></div></article>)}
    </aside>
  </section>

  <nav class="topic-nav shell" aria-label="热门主题">
    <strong>热门主题</strong><a href="/reviews/">月度红黑榜</a><a href="/guides/">Sing-box</a><a href="/guides/">Clash Verge Rev</a><a href="/routes/">IPLC / IEPL</a><a href="/routes/">BGP 路由</a><a href="/posts/streaming-unlock-test-baseline/">流媒体解锁</a>
  </nav>

  <section class="section latest-section" id="latest">
    <div class="shell">
      <div class="editorial-head"><div><span>NEW / 最新发布</span><h2>最新实测与技术文章</h2></div><p>每一篇测评都标注测试环境、时间窗口和结论边界，拒绝用一次测速代表长期体验。</p></div>
      <div class="magazine-grid">{latest.map((post, index) => <PostCard post={post} index={index} featured={index === 0 || index === 3} />)}</div>
    </div>
  </section>

  <section class="score-strip">
    <div class="shell score-grid">
      <div class="score-intro"><span>PEAK HOUR SNAPSHOT</span><h2>晚高峰，不只看下载速度</h2><p>固定 20:00—23:30 采样，综合关注延迟、抖动、丢包和持续吞吐。以下为版面演示样本，不作为购买依据。</p><a href="/about/">查看完整测试方法 →</a></div>
      <div class="score-card acid"><small>东京 IEPL</small><strong>842.6</strong><span>Mbps</span><div><b>38.2 ms</b><em>0% LOSS</em></div></div>
      <div class="score-card red"><small>香港 BGP</small><strong>516.3</strong><span>Mbps</span><div><b>21.6 ms</b><em>0.2% LOSS</em></div></div>
      <div class="score-card ink"><small>洛杉矶 Premium</small><strong>723.9</strong><span>Mbps</span><div><b>141 ms</b><em>0% LOSS</em></div></div>
    </div>
  </section>

  <section class="section channel-section">
    <div class="shell channel-grid">
      <article class="channel-card yellow"><span>01 / MONTHLY</span><h2>月度红黑榜</h2><p>每月初复盘稳定度、跨网表现、服务响应与潜在跑路风险。</p><a href="/reviews/">查看榜单 →</a></article>
      <article class="channel-card blue"><span>02 / HOW-TO</span><h2>客户端实操</h2><p>Sing-box、Clash Verge Rev 与 Loon 的分流、DNS 和排错教程。</p><a href="/guides/">学习配置 →</a></article>
      <article class="channel-card coral"><span>03 / ROUTE</span><h2>线路深度探秘</h2><p>拆解 IPLC、IEPL、BGP 与上游机房的入口、承载和回程。</p><a href="/routes/">进入线路库 →</a></article>
    </div>
  </section>
</Layout>
